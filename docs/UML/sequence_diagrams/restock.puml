@startuml sequence_diagram_restock
actor User
participant "main.py" as Main
participant "restock_service.py" as Restock
participant "product_dao.py" as DAO

User -> Main : input("Réapprovisionnement")
Main -> Restock : transferer_stock(id, q, magasin_src, magasin_dst)
Restock -> DAO : get_by_id(id, magasin_src)
DAO --> Restock : produit_src
Restock -> DAO : update(produit_src)
Restock -> DAO : get_by_id(id, magasin_dst)
DAO --> Restock : produit_dst ou None

alt produit_dst existe
    Restock -> DAO : update(produit_dst)
else produit_dst est None
    Restock -> DAO : insert(nouveau_produit)
end

Main --> User : confirmation
@enduml
