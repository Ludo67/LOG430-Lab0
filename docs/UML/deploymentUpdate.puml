@startuml
title Architecture Déployée - Microservices

cloud "Poste client" as client

node "Serveur 1" {
    [NGINX]
    [Redis]
    [Prometheus]
    [KrakenD]
}

node "Auth Service" {
    [Auth API]
    database "SQLite Auth"
}

node "Stock Service" {
    [Stock API]
    database "SQLite Stock"
}

node "Sale Service" {
    [Sale API]
    database "SQLite Sale"
}

node "Product Service" {
    [Product API]
    database "SQLite Product"
}

node "Location Service" {
    [Location API]
    database "SQLite Location"
}

client --> NGINX
NGINX --> KrakenD
KrakenD --> [Auth API]
KrakenD --> [Stock API]
KrakenD --> [Sale API]
KrakenD --> [Product API]
KrakenD --> [Location API]

[Auth API] --> "SQLite Auth"
[Stock API] --> "SQLite Stock"
[Sale API] --> "SQLite Sale"
[Product API] --> "SQLite Product"
[Location API] --> "SQLite Location"

Prometheus --> [Stock API]
Prometheus --> [Sale API]
Prometheus --> [Product API]
Prometheus --> [Location API]
@enduml
