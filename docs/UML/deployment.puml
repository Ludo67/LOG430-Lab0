@startuml deployment

node "Poste développeur (local)" {
  node "FastAPI + Uvicorn" {
    component "main.py"
    component "stock_route"
    component "restock_routes"
    component "reporting_routes"
    component "auth"
  }

  node "VirtualEnv (.venv)" {
    artifact "FastAPI"
    artifact "Uvicorn"
    artifact "SQLAlchemy"
    artifact "httpx"
    artifact "pytest"
  }

  database "SQLite (produits.db)"
}

"stock_route" --> "FastAPI"
"restock_routes" --> "FastAPI"
"reporting_routes" --> "FastAPI"
"FastAPI" --> "SQLAlchemy"
"SQLAlchemy" --> "SQLite (produits.db)"

@enduml
