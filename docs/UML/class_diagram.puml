@startuml class_diagram

package "data_access_layer" {
  class ProduitDAO {
    +get_all()
    +get_by_id(id)
    +rechercher(terme)
    +update(produit)
    +close()
  }
}

package "service_layer" {
  class StockService {
    +rechercher_produit(terme)
    +enregistrer_vente(id, quantite)
    +annuler_vente(id, quantite)
    +lister_stock()
  }
}

package "presentation_layer" {
  class Main {
    +main()
  }
}

Main --> StockService
StockService --> ProduitDAO

@enduml