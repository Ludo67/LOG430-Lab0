@startuml class_diagram

package "data_access_layer" {
  class ProduitDAO {
    +get_all()
    +get_by_id(id, magasin_id)
    +rechercher(terme)
    +update(produit)
    +close()
    +get_ventes_par_magasin()
  }
}

package "service_layer" {
  class StockService {
    +lister_stock()
    +rechercher_produit(terme)
    +enregistrer_vente(id, quantite, magasin_id)
    +annuler_vente(id, quantite, magasin_id)
  }

  class ReportingService {
    +rapport_ventes()
    +produits_en_rupture(seuil)
    +tableau_de_bord()
  }

  class RestockService {
    +transferer_stock(produit_id, quantite, magasin_source, magasin_cible)
  }
}

package "api" {
  class stock_route
  class restock_routes
  class reporting_routes
  class auth
  class schemas
}

"stock_route" --> StockService
"restock_routes" --> RestockService
"reporting_routes" --> ReportingService

StockService --> ProduitDAO
RestockService --> ProduitDAO
ReportingService --> ProduitDAO

@enduml
