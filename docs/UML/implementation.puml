@startuml implementation
package "Service Layer" {
  [StockService]
  [RestockService]
  [ReportingService]
}

package "Data Access Layer" {
  [ProduitDAO]
  [Base SQLAlchemy]
}

package "Presentation Layer" {
  [main.py]
}

[main.py] --> [StockService]
[main.py] --> [RestockService]
[main.py] --> [ReportingService]
[StockService] --> [ProduitDAO]
[ProduitDAO] --> [Base SQLAlchemy]

@enduml