[MASTER]
# Ajouter tous les fichiers .py du projet
ignore=venv
load-plugins=

[MESSAGES CONTROL]
disable=
    missing-docstring,
    invalid-name,
    too-few-public-methods,
    duplicate-code
disable=E0401


[FORMAT]
# Longueur maximale d'une ligne
max-line-length=100

[DESIGN]
# Autorise plus de branches dans une fonction (utile pour menus interactifs)
max-branches=20
# Réduit les avertissements pour des fonctions complexes si nécessaire
max-locals=20
max-returns=10

[TYPECHECK]
# Évite les erreurs sur les objets SQLAlchemy dynamiques
generated-members=session,query,filter_by,commit,add

[REPORTS]
# Ne pas afficher le rapport global
reports=no
